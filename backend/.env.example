# MongoDB connection string. Use MongoDB Atlas free tier for deployment:
# https://www.mongodb.com/cloud/atlas/register
# Atlas example:
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017
DB_NAME=nearvita
# Set true only for local demo without a database. Atlas URIs never use mock.
USE_MOCK_DB=false

# Generate a long random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_string

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGINS=http://localhost:3000

# Fallback single origin if CORS_ORIGINS isn't set
FRONTEND_URL=http://localhost:3000

# Seeded admin account (created automatically on first startup)
ADMIN_EMAIL=admin@nearvita.health
ADMIN_PASSWORD=Admin@1234
